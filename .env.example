# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed locally for `supabase link` / `db push`
SUPABASE_DB_PASSWORD=

# AliExpress Affiliate API (optional - without it, import falls back to page extraction)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Admin (only this email can access /admin)
ADMIN_EMAIL=ahmedqlila99@gmail.com
# Public base URL (used for sitemap, Open Graph, auth redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
